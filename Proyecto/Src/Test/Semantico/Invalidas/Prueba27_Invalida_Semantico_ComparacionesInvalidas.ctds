void main () {
    int i;
    float f;
    boolean b1;
    boolean b2;

    i = 10;
    f = 3.5;
    b1 = true;

    b2 = b1 < i;    // boolean < int.
    b2 = i < b1;    // int < boolean.
    b2 = b1 > f;    // boolean > float.
    b2 = f > b1;    // float > boolean.
    b2 = b1 < b1;   // boolean < boolean.
    b2 = b1 > b1;   // boolean > boolean.
}