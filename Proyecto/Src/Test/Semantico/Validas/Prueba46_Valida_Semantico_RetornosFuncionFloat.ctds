float funcion_float_uno () {
    return 19.21;  // return float_expr.
}

float funcion_float_dos () {
    float x;
    x = 20.99;
    return x;   // return float_variable.
}

float funcion_float_tres () {
    return 0;   // return int_expr (warning).
}

void main () {
    float a;
    a = funcion_float_uno ();
    a = funcion_float_dos ();
    a = funcion_float_tres ();
}