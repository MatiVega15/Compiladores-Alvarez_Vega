int evaluar_bloque (int x) {
    {
        int interno;
        interno = x * 10;
        return interno;
    }
}

int evaluar_if_sin_else (int x) {
    if (x > 0) {
        return 1;
    }

    return 0;
}

void main () {
    int r1, r2;
    r1 = evaluar_bloque (5);
    r2 = evaluar_if_sin_else (-3);
}