extern int get_int ();
extern void printInt (int x);
extern float descuento (float monto, float saldo, boolean descontar);

int inc (int x) {
    return x + 1;
}

void main () {
    int y;
    
    y = inc (get_int ());
    
    if (y == 1) {
        printInt (1);
    }
    else {
        printInt (0);
    }
    
    descuento (200.40, 512.1, true);

    return;
}