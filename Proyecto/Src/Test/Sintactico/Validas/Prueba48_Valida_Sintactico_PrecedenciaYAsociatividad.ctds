int main () {
    int resultado;
    boolean a;
    boolean b;
    boolean c;

    resultado = 10 + 20 * 3;
    resultado = 10 * 20 / 3;
    resultado = 10 + 20 - 5;
    resultado = -10 * 2;
    resultado = !a && b;
    resultado = a && b || c;
    resultado = 10 < 20;
    resultado = 10 == 10;
    resultado = 10 + 20 * 3 < 100 && a || b;
    resultado = (10 + 20) * 3;
    resultado = !!a;
}