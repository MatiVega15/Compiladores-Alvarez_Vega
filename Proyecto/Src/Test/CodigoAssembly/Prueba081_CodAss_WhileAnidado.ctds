extern void printInt (int valor);

void main () {
    int outer, inner, count;
    outer = 0;
    count = 0;
    
    while (outer < 3) {
        inner = 0;
        while (inner < 2) {
            count = count + 1;
            inner = inner + 1;
        }
        outer = outer + 1;
    }
    
    printInt (count);
}