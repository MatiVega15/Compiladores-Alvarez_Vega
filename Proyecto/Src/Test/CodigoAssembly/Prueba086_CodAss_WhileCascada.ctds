extern void printInt (int valor);

void main () {
    int i;
    i = 1;
    
    while (i < 4) {
        if (i == 1) {
            printInt (10);
        } else {
            if (i == 2) {
                printInt (20);
            } else {
                printInt (30);
            }
        }
        i = i + 1;
    }
}