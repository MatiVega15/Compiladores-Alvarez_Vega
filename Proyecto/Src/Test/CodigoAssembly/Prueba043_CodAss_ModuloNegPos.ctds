int n1;

extern void printInt (int valor);

void main () {
    int n2, n3;
    int temp1, temp2, temp3, temp4;

    // Módulo NegPos con variable global.
    n1 = -1004;
    n2 = 132;
    n1 = n1 % n2;

    // Módulo NegPos con variables locales.
    n3 = 66;
    temp1 = -132 % n3;

    // Módulo NegPos con literales.
    temp2 = -10 % 3;

    // Módulos encadenados con NegPos.
    temp3 = n1 % n2 % n3 % 5;

    // Resto conservando signo negativo del dividendo.
    temp4 = -66 % 100;

    printInt (n1);
    printInt (temp1);
    printInt (temp2);
    printInt (temp3);
    printInt (temp4);

    // Módulo directo NegPos.
    printInt (-5009 % 10);
}