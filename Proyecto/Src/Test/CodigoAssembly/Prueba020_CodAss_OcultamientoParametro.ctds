extern void printInt (int valor);

void ocultar (boolean b) {
    b = true;

    if (b) {
        printInt (1);
    }
    else {
        printInt (0);
    }
}

void main () {
    boolean b;
    b = false;

    ocultar (b);

    if (b) {
        printInt (1);
    }
    else {
        printInt (0);
    }
}