extern void printInt (int valor);

boolean menores_a_100 (int a, int b, int c, int d, int e, int f, int g, boolean h) {
    if (h) {
        if (a < 100 &&
            b < 100 &&
            c < 100 &&
            d < 100 &&
            e < 100 &&
            f < 100 &&
            g < 100) {
                return true;
            }
        else {
            return false;
        }
    }

    return false;
}

void main () {
    if (menores_a_100 (99, 10, -20, 1, 0, 5, -9, true)) {
        printInt (1);
    } else {
        printInt (0);
    }
}