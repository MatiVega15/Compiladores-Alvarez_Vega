int g;

extern void printInt (int valor);

int clasificar (int x) {
    if (x > 0) {
        return 100;
    } else {
        return -100;
    }

    // Ninguna instrucción acá abajo debería ejecutarse jamás.
    g = 55;
}

void main () {
    g = 10;
    
    printInt (clasificar (5));  // Debe imprimir 100.
    printInt (clasificar (-2)); // Debe imprimir -100.
    printInt (g); // Debe imprimir 10.
}