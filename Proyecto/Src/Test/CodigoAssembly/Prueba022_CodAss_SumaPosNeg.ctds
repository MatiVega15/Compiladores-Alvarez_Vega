int n1;

extern void printInt (int valor);

void main () {
    int n2, n3;
    int temp1, temp2, temp3, temp4;

    // Suma PosNeg con variable global.
    n1 = 1004;
    n2 = -132;
    n1 = n1 + n2;

    // Suma PosNeg con variables locales.
    n3 = -66;
    temp1 = 132 + n3;

    // Suma PosNeg con literales.
    temp2 = 10 + -2;

    // Sumas encadenadas con PosNeg.
    temp3 = n1 + n2 + n3 + -10;

    // Elemento neutro con negativo.
    temp4 = n3 + 0;

    printInt (n1);
    printInt (temp1);
    printInt (temp2);
    printInt (temp3);
    printInt (temp4);

    // Suma directa PosNeg.
    printInt (5009 + -9);
}